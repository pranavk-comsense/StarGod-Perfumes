# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------
# Local: printed by `npx supabase start` / `npx supabase status`.
# Hosted: Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Bypasses RLS. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Google OAuth (configured in Supabase Auth, read by supabase/config.toml for local dev)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Phone OTP via Twilio (configured in Supabase Auth). India requires DLT-registered templates.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# --- Cashfree Payments ---------------------------------------------
# sandbox | production
NEXT_PUBLIC_CASHFREE_MODE=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# --- Shipmozo (shipping-api.com panel > Settings > API) -----------------------
# Without keys, staff enter courier + AWB by hand and pincode checks are estimates.
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=
# Optional: pickup warehouse id (default: the account's default/first warehouse)
SHIPMOZO_WAREHOUSE_ID=
# Pincode the store ships from (used for rates and serviceability)
SHIPMOZO_PICKUP_PINCODE=411030

# --- Transactional email (Resend) --------------------------------------------
# Without a key, emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Stargod Perfumes <orders@thestargod.com>"
# Optional: gets a copy of every new-order email
ADMIN_NOTIFICATION_EMAIL=

# --- Cron -------------------------------------------------------------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>". Use 16+ random chars.
CRON_SECRET=
